APP_NAME=BackendLegacy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legacy_products
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Docker (.env.docker): Redis for cache + queues — MySQL remains the primary database
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
SESSION_DRIVER=file
SESSION_LIFETIME=120
